---
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'de' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as 'de' | 'en';
---
<Base lang={lang} title="Sebastian Dehn" description="Sebastian Dehn – CV">
  <main><h1>Sebastian Dehn</h1></main>
</Base>
