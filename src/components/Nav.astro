---
import { getEntry } from 'astro:content';
import { altPath, ui } from '../i18n/ui';
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const other: Lang = lang === 'de' ? 'en' : 'de';
const profile = (await getEntry('profile', 'main'))!.data;
const switchHref = altPath(Astro.url.pathname, lang, other);
---
<header class="nav">
  <a class="skip" href="#main">{ui(lang, 'skip')}</a>
  <a class="logo" href={`/${lang}/`} aria-label={`${profile.name} – ${ui(lang, 'home')}`}>
    <span class="logo__mark">⟨sd⟩</span><span class="logo__name">sebastian dehn</span>
  </a>
  <nav class="nav__links">
    <a href={switchHref} hreflang={other} lang={other} data-lang-switch aria-label={ui(lang, 'switchLabel')}>
      {ui(lang, 'switchShort')}
    </a>
    <a href={profile.links.linkedin} rel="me noopener">LinkedIn</a>
    <a href={profile.links.github} rel="me noopener">GitHub</a>
    <a class="pill" href={`/cv/sebastian-dehn-cv-${lang}.pdf`}>{ui(lang, 'cv')}</a>
  </nav>
</header>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 10;
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    padding: 1rem var(--gutter);
    background: linear-gradient(var(--bg), color-mix(in srgb, var(--bg) 0%, transparent));
  }
  .logo { display: flex; gap: 0.6rem; align-items: baseline; text-decoration: none; font-size: 0.95rem; }
  .logo__mark { font-family: var(--font-mono); color: var(--cyan); }
  .nav__links { display: flex; gap: 1.25rem; align-items: center; font-size: 0.85rem; }
  .nav__links a { text-decoration: none; color: var(--text-2); }
  .nav__links a:hover { color: var(--text); }
  .nav__links [data-lang-switch] { font-family: var(--font-mono); letter-spacing: 0.15em; }
  .pill { border: 0.5px solid #3a3e4a; border-radius: 999px; padding: 0.35rem 1rem; color: var(--text) !important; }
  .pill:hover { border-color: var(--cyan); }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: var(--gutter); top: 0.5rem; background: var(--bg); padding: 0.25rem 0.5rem; }
  @media (max-width: 640px) {
    .logo__name { display: none; }
    .nav__links { gap: 0.9rem; font-size: 0.8rem; }
  }
</style>
