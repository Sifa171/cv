<script>
  const start = () => import('../scene/main').then((m) => m.mountScene(document.body));
  if ('requestIdleCallback' in window) requestIdleCallback(() => void start(), { timeout: 1500 });
  else setTimeout(() => void start(), 200);
</script>

<style is:global>
  .scene-canvas { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
  main, footer { position: relative; z-index: 1; }
</style>
