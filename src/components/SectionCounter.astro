---
import { ui } from '../i18n/ui';
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  first: string;
}

const { lang, first } = Astro.props;
---
<div class="counter mono-label" aria-hidden="true">
  <span class="counter__index" data-counter-index>00</span>
  <i class="counter__line"></i>
  <span data-counter-label>{first}</span>
  <span class="counter__ready">{ui(lang, 'ready')}</span>
</div>

<style>
  .counter { position: fixed; left: var(--gutter); bottom: 1.25rem; z-index: 5; display: flex; gap: 0.75rem; align-items: center; }
  .counter__index { color: var(--text); }
  .counter__line { display: inline-block; width: 4rem; height: 1px; background: linear-gradient(90deg, var(--indigo), var(--line)); }
  .counter__ready { color: var(--cyan); margin-left: 1rem; text-transform: none; letter-spacing: 0.05em; }
  .counter__ready::after { content: ''; display: inline-block; width: 0.5em; height: 1em; vertical-align: -0.15em; background: var(--cyan); animation: blink 1.1s steps(1) infinite; margin-left: 0.15em; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .counter__ready::after { animation: none; } }
  @media (max-width: 640px) { .counter__ready { display: none; } }
</style>
